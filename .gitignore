
# ==========================================
# ZozoMarket - Root Git Ignore
# ==========================================

# Environment variables and secrets
.env
.env.*
!.env.example
!.env.sample
!.env.template
**/.env
**/.env.*
!**/.env.example
!**/.env.sample
!**/.env.template
*.pem
*.key
secrets/
credentials/
service-account*.json

# Logs
*.log
logs/
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*
docs/*
docs/*.md
docs/architecture.md
docs/decisions.md
docs/error-log.md
docs/frontend.md


# Operating system files
.DS_Store
Thumbs.db
Desktop.ini
*.swp
*.swo
*~

# IDE and editor files
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.iml

