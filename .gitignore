.agents/**/memory/
.agents/**/sessions/
.agent-cache/
.agent-temp/
agents/
.cursor/
agent/
agents/**/memory/
agents/**/sessions/
agents/**/cache/
agents/**/temp/
agents/**/tmp/
agents/**/logs/
agents/**/errors/
agents/**/warnings/
