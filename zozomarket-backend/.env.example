# ---------------------------------------------------------------------------
# ZozoMarket API configuration. Copy to `.env` and adjust.
# ---------------------------------------------------------------------------

# development | test | staging | production
ENVIRONMENT=development
LOG_LEVEL=INFO
# Public URL of this API (used in tracking pixels, click/unsubscribe links, media URLs)
PUBLIC_BASE_URL=http://localhost:8000

# --- Security ---------------------------------------------------------------
# REQUIRED in production. Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-in-production-please-32+chars
# Comma-separated API keys for the management API (X-API-Key or Bearer).
# Leave empty ONLY for local development (auth disabled).
API_KEYS=
# HMAC secret for POST /api/v1/webhooks/email (X-Zozo-Signature: sha256=<hex>)
WEBHOOK_SECRET=

# --- CORS -------------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Database ---------------------------------------------------------------
# Local dev default is SQLite. Production: postgresql+asyncpg://user:pass@host:5432/db
DATABASE_URL=sqlite+aiosqlite:///./zozomarket.db
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
# Dev conveniences. In production set both to false and run `alembic upgrade head`.
AUTO_CREATE_TABLES=true
SEED_DEMO_DATA=true

# --- Background work --------------------------------------------------------
# inline = FastAPI BackgroundTasks + in-process scheduler (single instance)
# celery = Redis-backed Celery worker + beat (multi-instance / production)
TASK_BACKEND=inline
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_SECONDS=30
SEND_BATCH_SIZE=200

# --- Email delivery -----------------------------------------------------------
# console (logs only) | smtp (any relay incl. Amazon SES SMTP) | resend
EMAIL_PROVIDER=console
EMAIL_FROM_ADDRESS=hello@zozomarket.local
EMAIL_FROM_NAME=ZozoMarket
EMAIL_TRACKING_ENABLED=true
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
RESEND_API_KEY=

# --- AI copywriter ------------------------------------------------------------
# mock | openai | anthropic
AI_PROVIDER=mock
AI_FALLBACK_TO_MOCK=true
AI_TIMEOUT_SECONDS=30
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest

# --- Media --------------------------------------------------------------------
MEDIA_ROOT=./storage/media
MEDIA_MAX_UPLOAD_MB=50
