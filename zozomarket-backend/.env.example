# ---------------------------------------------------------------------------
# ZozoMarket API configuration. Copy to `.env` and adjust.
# ---------------------------------------------------------------------------

# development | test | staging | production
ENVIRONMENT=development
LOG_LEVEL=INFO
# Public URL of this API (used in tracking pixels, click/unsubscribe links, media URLs)
PUBLIC_BASE_URL=http://localhost:8000

# --- Security ---------------------------------------------------------------
# REQUIRED in production. Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-in-production-please-32+chars
# User Registration (set to false to temporarily stop account creation)
SIGNUP_ENABLED=false
# Optional machine keys. The dashboard signs in with POST /auth/login and a JWT.
# Leave empty. An empty list does not disable authentication.
API_KEYS=
ACCESS_TOKEN_MINUTES=60
REFRESH_TOKEN_DAYS=14
# HMAC secret for POST /api/v1/webhooks/email (X-Zozo-Signature: sha256=<hex>)
WEBHOOK_SECRET=

# --- CORS & Client ----------------------------------------------------------
# Frontend application URL making requests to this API
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Database ---------------------------------------------------------------
# PostgreSQL database `zozomarket` must already exist. Apply schema with: alembic upgrade head
DATABASE_URL=postgresql+asyncpg://postgres:root@127.0.0.1:5432/zozomarket
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
AUTO_CREATE_TABLES=false
SEED_DEMO_DATA=false

# --- Background work --------------------------------------------------------
# inline = FastAPI BackgroundTasks + in-process scheduler (single instance)
# celery = Redis-backed Celery worker + beat (multi-instance / production)
TASK_BACKEND=inline
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_SECONDS=30
SEND_BATCH_SIZE=200

# --- Email delivery -----------------------------------------------------------
# console (logs only) | ses (Amazon SES v2) | resend
EMAIL_PROVIDER=console
EMAIL_FROM_ADDRESS=hello@zozomarket.local
EMAIL_FROM_NAME=ZozoMarket
EMAIL_TRACKING_ENABLED=true
# IAM user that can call ses:SendEmail. Never commit real keys.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
# Verified SES identity. This is the From address on every message.
SES_FROM_EMAIL=info@zozothemes.com
# Optional. Attached when set, so SES can record opens and clicks.
SES_CONFIGURATION_SET=zozomarket-tracking
# CloudWatch dimension on that configuration set. Dashboard mail totals use it.
SES_CLOUDWATCH_DIMENSION_NAME=campaign
SES_CLOUDWATCH_DIMENSION_VALUE=zozomarket
RESEND_API_KEY=

# --- Media --------------------------------------------------------------------
MEDIA_ROOT=./storage/media
MEDIA_MAX_UPLOAD_MB=50
